<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== VISION-ONLY MODE: full screen camera ===== -->
    <FrameLayout
        android:id="@+id/vision_only_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />


    </FrameLayout>

    <!-- ===== COMBINED MODE: split screen (map top, camera bottom) ===== -->
    <LinearLayout
        android:id="@+id/combined_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- TOP: Map with search and navigation controls -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <fragment
                android:id="@+id/combined_map_fragment"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Search bar overlaid on map -->
            <TextView
                android:id="@+id/tv_search_destination"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="10dp"
                android:background="@android:color/white"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:hint="Search destination..."
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="true"
                android:textSize="16sp" />

            <!-- Navigation panel overlaid at bottom of map -->
            <LinearLayout
                android:id="@+id/nav_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#EE000000"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_nav_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingBottom="4dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_steps"
                    android:layout_width="match_parent"
                    android:layout_height="80dp" />

                <Button
                    android:id="@+id/btn_start_navigation"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="4dp"
                    android:text="Start Navigation"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- BOTTOM: Camera preview for continuous vision analysis -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.6"
            android:background="#000000">

            <androidx.camera.view.PreviewView
                android:id="@+id/previewViewCombined"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
                
            <View
                android:id="@+id/overlay_view_combined"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Vision instruction overlay on camera -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="#AA000000"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_last_instruction_combined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/tv_status_combined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vision active"
                    android:textColor="#AAAAAA"
                    android:textSize="11sp"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    <!-- Inside your main layout container (e.g., FrameLayout or ConstraintLayout) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/voice_popup"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_voice_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listening..."
                android:textColor="@android:color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Simple 4-dot "Assistant" style animation placeholder -->
            <ProgressBar
                android:id="@+id/voice_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:indeterminate="true" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ===== VISION-ONLY CONTROLS (bottom overlay, hidden in combined mode) ===== -->
    <LinearLayout
        android:id="@+id/vision_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_last_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textColor="#AAAAAA"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_toggle_analysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pause Analysis" />
    </LinearLayout>

</FrameLayout>
