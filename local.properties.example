# Copy to local.properties (gitignored) and fill in your keys.
# Android Studio often creates local.properties automatically for sdk.dir.

sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

GEMINI_API_KEY=your_gemini_api_key
GOOGLE_MAPS_KEY=your_google_maps_key
GOOGLE_DIRECTIONS_KEY=your_google_directions_key
